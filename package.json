{
  "name": "interner",
  "version": "1.0.0",
  "description": "Fresh maximally shared clones of JavaScript value graphs",
  "keywords": [
    "interning",
    "hash-consing",
    "structural-sharing",
    "graph",
    "deduplication",
    "bisimulation"
  ],
  "author": "Scover",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/5cover/interner.git"
  },
  "homepage": "https://github.com/5cover/interner#readme",
  "bugs": {
    "url": "https://github.com/5cover/interner/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "pnpm build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none test/**/*.test.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "smoke": "pnpm build && node scripts/smoke.mjs",
    "bench": "pnpm build && node --expose-gc --import tsx bench/run.ts --profile quick",
    "bench:quick": "pnpm build && node --expose-gc --import tsx bench/run.ts --profile quick",
    "bench:full": "pnpm build && node --expose-gc --import tsx bench/run.ts --profile full",
    "bench:memory": "pnpm build && node --expose-gc --import tsx bench/run.ts --profile quick --only memory",
    "bench:report": "node --import tsx bench/report.ts",
    "bench:plots": "node --import tsx bench/plots.ts",
    "bench:readme": "node --import tsx bench/report.ts --readme",
    "bench:compare": "node --import tsx bench/compare.ts",
    "mutate": "stryker run",
    "mutate:audit": "node scripts/mutation-audit.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm lint && pnpm smoke"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "singleQuote": true,
    "arrowParens": "avoid",
    "bracketSameLine": true,
    "trailingComma": "es5",
    "semi": false
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@memlab/core": "^2.0.5",
    "@memlab/heap-analysis": "^2.0.5",
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "^26.6.1",
    "eslint": "^10.10.0",
    "fast-check": "^4.10.1",
    "js-yaml": "^5.4.2",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vega": "^6.4.0",
    "vega-lite": "^6.4.3",
    "zod": "4.6.5"
  }
}
